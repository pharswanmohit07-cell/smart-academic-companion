# Copy to .env for local development. NEVER commit .env.
# On Render, set the same names in the service's Environment tab.

# --- Flask -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=1
APP_BASE_URL=http://127.0.0.1:5000

# --- Supabase --------------------------------------------------------------
# Project settings -> API. The publishable key is the anon key (public).
SUPABASE_URL=https://dofildfkumoboghnrgox.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Service-role key: server only. Leave empty unless a server task needs it.
SUPABASE_SECRET_KEY=

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the local SQLite file (academic_companion.db).
# For production use the Supabase Session pooler URI:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_FILE=

# --- Optional hardening ----------------------------------------------------
# Restrict sign-ups to college domains (comma separated):
# ALLOWED_EMAIL_DOMAINS=college.edu.in
COOKIE_SECURE=0
SESSION_LIFETIME_MINUTES=480
LOG_LEVEL=INFO
